name: Build PWA APK
on:
  push:
    branches: [ main ]  # 往main分支推送代码，自动打包
  workflow_dispatch:    # 支持手动点击按钮打包（推荐保留）

jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - name: 拉取仓库代码
        uses: actions/checkout@v4

      - name: 安装Node.js
        uses: actions/setup-node@v4
        with:
          node-version: 20

      - name: 全局安装 Bubblewrap
        run: npm install -g @bubblewrap/cli

      - name: 初始化Bubblewrap配置
        run: |
          bubblewrap init \
            --manifest https://zym0313.github.io/Daily-check-in/mark/manifest.json \
            --packageId com.cat.checkin \
            --overwrite

      - name: 构建无签名调试APK
        run: bubblewrap build --skipSigning

      - name: 上传APK产物，构建完成后下载
        uses: actions/upload-artifact@v4
        with:
          name: cat-checkin-debug-apk
          path: ./app/outputs/apk/release/app-release-unsigned.apk
